module(
    name = "homelab_diagram",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.5.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

RESVG_RELEASE_URL = "https://github.com/linebender/resvg/releases/download/v0.50.0"

RESVG_BUILD_FILE = """
filegroup(
    name = "resvg_bin",
    srcs = ["resvg"],
    visibility = ["//visibility:public"],
)
"""

RESVG_WIN_BUILD_FILE = """
filegroup(
    name = "resvg_bin",
    srcs = ["resvg.exe"],
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "resvg_linux_x86_64",
    build_file_content = RESVG_BUILD_FILE,
    patch_cmds = ["chmod +x resvg"],
    sha256 = "5d1c9ffd43c82fb802d92cef8100055c612cd3e248d5a787c20079293a456e21",
    urls = [RESVG_RELEASE_URL + "/resvg-linux-x86_64.tar.gz"],
)

http_archive(
    name = "resvg_linux_aarch64",
    build_file_content = RESVG_BUILD_FILE,
    patch_cmds = ["chmod +x resvg"],
    sha256 = "b197bf704c9da5d572ae565c799727da3067dffacaf32a2476c8143af90e2f9c",
    urls = [RESVG_RELEASE_URL + "/resvg-linux-aarch64.tar.gz"],
)

http_archive(
    name = "resvg_macos_x86_64",
    build_file_content = RESVG_BUILD_FILE,
    patch_cmds = ["chmod +x resvg"],
    sha256 = "f47150b41b41842c629ea9c397ce0f3373451549f47ea1c44f950866a992363f",
    urls = [RESVG_RELEASE_URL + "/resvg-macos-x86_64.zip"],
)

http_archive(
    name = "resvg_macos_aarch64",
    build_file_content = RESVG_BUILD_FILE,
    patch_cmds = ["chmod +x resvg"],
    sha256 = "8155b569f2b93723ba3645b53536eead3b591c8faf62bdaafd3033ba37838837",
    urls = [RESVG_RELEASE_URL + "/resvg-macos-aarch64.zip"],
)

http_archive(
    name = "resvg_win_x86_64",
    build_file_content = RESVG_WIN_BUILD_FILE,
    sha256 = "e4817e40ac63d3eb5c9e5762526cf6cc91f0cc108de38cd09dd60be765184efd",
    urls = [RESVG_RELEASE_URL + "/resvg-win-x86_64.zip"],
)

http_archive(
    name = "resvg_win_aarch64",
    build_file_content = RESVG_WIN_BUILD_FILE,
    sha256 = "f3a6e7b8f07c9e6253fb18d45034e144baccbe203a5f3ab294d6f730807f22ed",
    urls = [RESVG_RELEASE_URL + "/resvg-win-aarch64.zip"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "diagram_pip",
    python_version = "3.12",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "diagram_pip")
